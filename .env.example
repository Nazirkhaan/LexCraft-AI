[TEMPLATE]
# Copy this file to .env and fill in your real key. Never commit .env.

# Google Gemini API key (required)
GEMINI_API_KEY=your_real_key

# Preferred model (optional). The app automatically retries transient Google
# errors and falls back through stable aliases (gemini-flash-latest ->
# gemini-flash-lite-latest -> gemini-3.5-flash -> gemini-3.5-flash-lite), so a
# saturated model no longer breaks generation. Set this to pin one specific model.
GEMINI_MODEL=gemini-flash-latest

# FastAPI backend URL used by the Streamlit frontend
BACKEND_URL=http://127.0.0.1:8000
