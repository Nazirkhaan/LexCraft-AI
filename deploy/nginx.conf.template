# LexCraft AI — nginx reverse proxy (single public port).
# Rendered from this template by start.sh with the platform's $PORT.
#
#   /        → Streamlit UI (WebSocket-capable)
#   /health  → FastAPI health endpoint (container/platform health check)
#   /api/…   → FastAPI (same-origin API access)
#   /docs    → FastAPI OpenAPI UI (same-origin API access)
#
# Streamlit requires HTTP/1.1 + Connection upgrade handling for its
# persistent WebSocket sessions — the /_stcore/stream location keeps
# sessions alive for the life of the tab.

worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    sendfile on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream streamlit {
        server 127.0.0.1:8501;
    }

    upstream fastapi {
        server 127.0.0.1:8000;
    }

    server {
        listen ${PORT};
        server_name _;

        # FastAPI health endpoint (used by container HEALTHCHECK / platform)
        location = /health {
            proxy_pass http://fastapi/health;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
        }

        # Same-origin API access: /api/generate → FastAPI /generate
        location /api/ {
            proxy_pass http://fastapi/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        # Streamlit's persistent WebSocket stream — long-lived, upgrade-aware
        location /_stcore/stream {
            proxy_pass http://streamlit;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_buffering off;
        }

        # Everything else → Streamlit UI
        location / {
            proxy_pass http://streamlit;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400s;
            proxy_buffering off;
        }
    }
}
