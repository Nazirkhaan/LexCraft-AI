# Copy this file to .env and fill in your real key. Never commit .env.

# Google Gemini API key (required)
GEMINI_API_KEY=your_real_key

# Model override (optional). The default 'gemini-flash-latest' alias always
# resolves to the newest flash model on your account; or pin a specific one,
# e.g. gemini-2.5-flash or gemini-1.5-pro.
GEMINI_MODEL=gemini-flash-latest

# FastAPI backend URL used by the Streamlit frontend
BACKEND_URL=http://127.0.0.1:8000
